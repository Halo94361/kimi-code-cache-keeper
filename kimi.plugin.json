{
  "name": "cache-keeper",
  "version": "0.2.12",
  "description": "通过 ACP 临时 fork 进行零主上下文污染的 prompt-cache 保活",
  "skills": "./skills/",
  "commands": "./commands/",
  "interface": {
    "displayName": "Cache Keeper",
    "shortDescription": "使用独立 fork 维持 Kimi Code 会话缓存"
  },
  "mcpServers": {
    "keeper": {
      "command": "node",
      "args": [
        "./dist/mcp.js"
      ]
    }
  },
  "hooks": [
    {
      "event": "UserPromptSubmit",
      "matcher": ".*",
      "command": "node ./dist/hooks/session-code.js",
      "timeout": 5
    },
    {
      "event": "SessionStart",
      "command": "node ./dist/hooks/session-code.js",
      "timeout": 5
    },
    {
      "event": "PreCompact",
      "command": "node ./dist/hooks/session-code.js",
      "timeout": 5
    },
    {
      "event": "PostCompact",
      "command": "node ./dist/hooks/session-code.js",
      "timeout": 5
    },
    {
      "event": "TurnStarted",
      "command": "node ./dist/hooks/activity.js",
      "timeout": 5
    },
    {
      "event": "Stop",
      "command": "node ./dist/hooks/activity.js",
      "timeout": 5
    },
    {
      "event": "StopFailure",
      "command": "node ./dist/hooks/activity.js",
      "timeout": 5
    },
    {
      "event": "Interrupt",
      "command": "node ./dist/hooks/activity.js",
      "timeout": 5
    },
    {
      "event": "SessionEnd",
      "command": "node ./dist/hooks/activity.js",
      "timeout": 5
    }
  ]
}
